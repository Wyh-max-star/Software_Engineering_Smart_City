{
  "_README": "iCity 模板化核心数据文件。前端(模板商城)与 Blender 插件(应用模板)共用同一份。以下凡是 _ 开头的键都是【注释/文档】，程序会自动忽略，不影响 JSON.parse / json.load。",
  "_warning_naming": "命名后缀不统一！树/椅/灯结尾是 _ICity_Default；隔离柱/设施结尾是 _Default_ICity；路面材质结尾是 _Default。抄名字时务必一字不差(含空格、大小写)。",
  "version": "1.0",
  "theme": "Default",
  "_theme_note": "icity 目前只有 Default 一个主题(assets/Assets 下只有 Default 文件夹)，所以 sna_theme 固定 Default。",
  "_fieldGuide": {
    "_note": "==== 字段说明，看这里 ====",
    "templates[].display": "前端展示给人看的整数。约定[整数=资产编号]，与 catalog 里的 id 一致。",
    "templates[].plugin": "插件真正调用的【真实资产/材质名】，机器用的，必须和 icity 资产库完全一致。",
    "templates[].plugin.tree": "对应 scene.sna_street_asset_type='Tree' + sna_street_asset_browser=该名字",
    "templates[].plugin.bench": "对应 sna_street_asset_type='Bench' + sna_street_asset_browser=该名字",
    "templates[].plugin.road_material": "对应 sna_road_materials_type_='Road' + sna_road_materials_browser=该名字",
    "templates[].source": "builtin=icity原有 / extended=资产扩充同学新增 / todo=待确认",
    "catalog": "全量可选资产清单(就是那张表)。造新模板时从这里挑 asset 名字填进 plugin。",
    "catalog.items[].desc": "资产外观描述(看缩略图人工确认)，给LLM做[自然语言->资产]映射用"
  },
  "_applyMechanism": {
    "_note": "==== 插件端如何应用一个模板，供写代码参考(已由 icity 源码证实，🟡画面效果待 Blender 验证) ====",
    "street_asset_types": [
      "Light",
      "Bench",
      "Tree",
      "Services",
      "Bollard",
      "Traffic light",
      "Cars",
      "Sign",
      "Texture",
      "Imperfection"
    ],
    "road_material_types": [
      "Road",
      "Curb",
      "Sidewalk"
    ],
    "steps_place_street_asset": [
      "1) scene.sna_street_asset_type = 'Tree'  (或 'Bench'/'Light'...)",
      "2) scene.sna_street_asset_browser = 'Tree1_Tree_ICity_Default'",
      "3) 进入 ICity Base 对象的编辑模式并选中路网",
      "4) bpy.ops.sna.road_apply_5c3ab()  -> 写入几何节点组 'Road 2' 输入"
    ],
    "steps_set_road_material": [
      "1) scene.sna_road_materials_type_ = 'Road'  (或 'Curb'/'Sidewalk')",
      "2) scene.sna_road_materials_browser = 'ICity_Road 4 clean_Default'",
      "3) (编辑模式下) bpy.ops.sna.road_apply_5c3ab()  -> Texture 分支写 'Road 2' inputs[2]"
    ],
    "operators": {
      "start": "sna.start_5209e  (初始化场景，加载 ICity start.blend)",
      "city_apply": "sna.city_apply_dae66  (写建筑/景观到网格属性，需Edit模式)",
      "road_apply": "sna.road_apply_5c3ab  (写道路材质/街道资产，需Edit模式)"
    },
    "geometry_node_inputs": {
      "_note": "Road apply 把资产写进几何节点组 'Road 2' 的不同输入(已由源码确认)，写插件函数时按类型分支：",
      "road_material_Texture": "nodes[road_materials_type].inputs[2] = bpy.data.materials[材质名]",
      "Services": "nodes['Services'].inputs[5] = bpy.data.collections[资产名]",
      "对象类_Tree_Bench_Light_Bollard等": "nodes[type].inputs[4] = bpy.data.objects[资产名]",
      "可见性属性": "Light 类 attribute_set value_bool=False；其余对象类 value_bool=True"
    },
    "scene_objects": {
      "_note": "Start 后场景里的关键对象/集合名(写函数时会用到)：",
      "edit_target": "ICity Base  (要进编辑模式、选路网的就是它)",
      "objects": [
        "ICity Road",
        "ICity Road Boundry",
        "ICity Spces",
        "ICity Procedural ground",
        "ICity building procedural base",
        "Procedural building_Default_ICity"
      ],
      "collections": [
        "ICity Assets",
        "ICity_Procedural",
        "ICity_Landscape"
      ],
      "node_group": "Road 2",
      "materials_object": "ICity_Materials"
    }
  },
  "_previews": {
    "_note": "每个资产都有同名缩略图 .png，前端可换成 iCity 真实缩略图(UI更有说服力，UI项2分)。基准目录 icity/assets/Assets/Default/。",
    "rule": "多数情况 预览图 = <资产名>.png，位于该类别的源文件夹。",
    "folders": {
      "tree/bench/light/bollard/sign/road_material/curb/sidewalk": "Default/Road/",
      "building_preset": "Default/Building presets/",
      "landscape": "Default/Building landscape/",
      "park": "Default/Park/"
    },
    "exceptions": {
      "services": "预览名多插了 _Services，例：资产 Electric box1_Default_ICity -> 预览 Electric box1_Services_Default_ICity.png",
      "skyscraper06_08": "预览文件名首字母小写：skyscraper06_..png / skyscraper08_..png",
      "manhole": "未发现对应预览图",
      "road_material": "Road 文件夹里同时有 带_Default 和 不带_Default 两种png，用带 _Default 的那张"
    }
  },
  "_cityStructure": {
    "_note": "城市结构相关枚举(来自源码)，做更复杂模板/建筑时参考：",
    "city_space_type": [
      "Procedural",
      "Park",
      "Presets",
      "Custom"
    ],
    "building_preset_type_enum": [
      "Skyscrapper",
      "Court",
      "Market",
      "Fire station",
      "Police station",
      "Hospital"
    ]
  },
  "_gaps": {
    "_note": "已发现的缺口(可作为'新增资产'方向，正好满足作业'新增2D/3D资产'要求)：",
    "cars": "街道资产类型有 'Cars'，但 Default 库里没有车辆资产(SCGS 里有 car.blend 可借) -> 交通模拟同学",
    "building_types_without_asset": "建筑类型枚举有 Market/Fire station/Police station/Hospital，但实际只有 Court/museum/Skyscraper 预设，缺对应模型",
    "themes": "只有 Default 一个主题，没有古典/现代等多风格"
  },
  "_extensionHooks": {
    "_note": "可借 SCGS(=icity+扩展)里现成的代码扩充模板能力，按需对接相应同学：",
    "weather_daynight": "SCGS/weather.py、copilot.py 有 雨/雪/白天/夜晚 函数 -> 自然语言编辑同学",
    "traffic": "SCGS/change_traffic_road.py、assets/car.blend -> 交通模拟同学",
    "layout": "SCGS/create_city_layout.py、set layout.py、main_path_building.py -> 布局控制同学"
  },
